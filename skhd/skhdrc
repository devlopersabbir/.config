############################################################
# SKHD + YABAI CONFIG (STRUCTURED)
# ----------------------------------------------------------
# DO NOT EDIT LOGIC — ONLY ORGANIZATION ADDED
############################################################



############################
# APPS LAUNCH SHORTCUTS
############################

# Safari
alt - s : run-external "open" "-a" "/Applications/Safari.app/Contents/MacOS/Safari"

# Telegram
alt - t : run-external "open" "-a" "/Applications/Telegram.app/Contents/MacOS/Telegram"

# Obsidian
alt - o : run-external "open" "-a" "/Applications/Obsidian.app/Contents/MacOS/Obsidian"

# Show date
alt - d : osascript ~/.config/skhd/applescripts/pop.scpt

# Close notifications
ralt - n : osascript ~/.config/skhd/applescripts/notifications.scpt

# Notion
lalt - n : run-external "open" "-a" "/Applications/Notion.app/Contents/MacOS/Notion"

# Min browser
ralt - m : run-external "open" "-a" "/Applications/Min.app/Contents/MacOS/Min"

# QuickTime
alt - q : run-external "open" "-a" `/System/Applications/QuickTime Player.app/Contents/MacOS/QuickTime Player`

# FinalCut
alt - f : run-external "open" "-a" `/Applications/Final Cut Pro.app/Contents/MacOS/Final Cut Pro`

# Ghostty terminal
alt - g : run-external "open" "-a" "/Applications/Ghostty.app"



############################
# WINDOW FOCUS MOVEMENT
############################

# change window focus within space
cmd - j : yabai -m window --focus south
cmd - k : yabai -m window --focus north
cmd - h : yabai -m window --focus west
cmd - l : yabai -m window --focus east

# change focus between external displays (left and right)
ctrl - h: yabai -m display --focus west
ctrl - l: yabai -m display --focus east



############################
# SPACE LAYOUT CONTROL
############################

# rotate layout clockwise
shift + cmd - r : yabai -m space --rotate 270

# flip along y-axis
shift + cmd - y : yabai -m space --mirror y-axis

# flip along x-axis
shift + cmd - x : yabai -m space --mirror x-axis

# balance out tree of windows (resize to occupy same area)
shift + cmd - e : yabai -m space --balance



############################
# WINDOW STATE CONTROL
############################

# toggle window float
shift + cmd - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# maximize a window
shift + cmd - m : yabai -m window --toggle zoom-fullscreen

# macOS native fullscreen
shift + cmd - f : yabai -m window --toggle native-fullscreen



############################
# WINDOW SWAP / MOVE
############################

# swap windows
shift + cmd - j : yabai -m window --swap south
shift + cmd - k : yabai -m window --swap north
shift + cmd - h : yabai -m window --swap west
shift + cmd - l : yabai -m window --swap east

# move window and split (warp)
ctrl + cmd - j : yabai -m window --warp south
ctrl + cmd - k : yabai -m window --warp north
ctrl + cmd - h : yabai -m window --warp west
ctrl + cmd - l : yabai -m window --warp east



############################
# DISPLAY MANAGEMENT
############################

# move window to display left and right
shift + cmd - s : yabai -m window --display west; yabai -m display --focus west;
shift + cmd - g : yabai -m window --display east; yabai -m display --focus east;



############################
# SPACE NAVIGATION
############################

# move window to prev and next space
shift + cmd - p : yabai -m window --space prev;
shift + cmd - n : yabai -m window --space next;



############################
# WINDOW RESIZING
############################

# increase window size (width)
alt + shift - l : yabai -m window --resize left:-50:0; yabai -m window --resize right:50:0

# decrease window size (width)
alt + shift - h : yabai -m window --resize left:50:0; yabai -m window --resize right:-50:0

# increase window size (height)
alt + shift - k : yabai -m window --resize top:-50:0; yabai -m window --resize bottom:50:0

# decrease window size (height)
alt + shift - j : yabai -m window --resize bottom:50:0; yabai -m window --resize top:-50:0


############################
# YABAI SERVICE CONTROL
############################

ctrl + cmd - q : yabai --stop-service
ctrl + cmd - s : yabai --start-service
ctrl + cmd - r : yabai --restart-service



############################
# CONFIG RELOAD
############################

# reload yabai config
alt - r : yabai --reload-config

# reload skhdrc
alt - s : skhd reload


############################
# Moving window to the space
############################
shift + cmd - u : yabai -m window --space prev
shift + cmd - i : yabai -m window --space next

# Focus spaces with a number
shift + cmd - 1 : yabai -m window --space 1
shift + cmd - 2 : yabai -m window --space 2
shift + cmd - 3 : yabai -m window --space 3
shift + cmd - 4 : yabai -m window --space 4
shift + cmd - 5 : yabai -m window --space 5
shift + cmd - 6 : yabai -m window --space 6
shift + cmd - 7 : yabai -m window --space 7
